# WG-Easy, managed: also brings up wg0 and its nftables rules inside the container.
# Rootless: the process is root of its own user namespace, which on the host is the user who
# started it, and it holds a single capability, NET_ADMIN, valid only in that namespace.
#
# The host needs the wireguard kernel module already loaded (a user namespace can't load
# modules); without it, wg-quick falls back to wireguard-go through /dev/net/tun.
#
#   podman secret create wg-easy-password-hash -   # paste the bcrypt hash, then Ctrl-D
#   install -Dm644 wg-easy-managed.container -t ~/.config/containers/systemd/
#   systemctl --user daemon-reload && systemctl --user start wg-easy-managed

[Unit]
Description=WG-Easy (managed)
Wants=network-online.target
After=network-online.target

[Container]
ContainerName=wg-easy
Image=ghcr.io/iomega8561/wg-easy:managed
PublishPort=127.0.0.1:3000:3000
PublishPort=51820:51820/udp

# No keep-id: root inside is your user outside, so ~/.wg-easy stays yours, and root needs no
# extra capability to read and write it.
User=0
Volume=%h/.wg-easy:/opt/wg:Z

Environment=WG_HOST=vpn.example.org
Environment=WG_MANAGED=true
Environment=PASSWORD_HASH_FILE=/run/secrets/wg-easy-password-hash
Secret=wg-easy-password-hash,type=mount,target=/run/secrets/wg-easy-password-hash,mode=0400

ReadOnly=true
DropCapability=ALL
AddCapability=NET_ADMIN
NoNewPrivileges=true
AddDevice=/dev/net/tun
Sysctl=net.ipv4.ip_forward=1
Sysctl=net.ipv4.conf.all.src_valid_mark=1

HealthCmd=["node", "/opt/wg-easy/dist/lib/healthcheck.js"]
HealthInterval=30s

[Service]
Restart=on-failure
MemoryMax=256M
TasksMax=64

[Install]
WantedBy=default.target
